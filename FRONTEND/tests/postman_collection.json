  "item": [
    {
      "name": "1. Configuración válida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Devuelve el id', function () { pm.expect(pm.response.json()).to.have.property('id'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"menor_id\": \"pablo\",\n  \"nombre\": \"Casa a escuela\",\n  \"dias\": [\n    \"lun\",\n    \"mar\",\n    \"mie\",\n    \"jue\",\n    \"vie\"\n  ],\n  \"hora_inicio\": \"07:30\",\n  \"hora_fin\": \"08:15\",\n  \"puntos\": [\n    {\n      \"latitud\": 19.4,\n      \"longitud\": -99.03\n    },\n    {\n      \"latitud\": 19.4075,\n      \"longitud\": -99.0225\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/rutas-habituales",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "rutas-habituales"
          ]
        }
      }
